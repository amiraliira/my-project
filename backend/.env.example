# PAK backend configuration template — manual Uvicorn
# Copy to backend/.env and edit that private file; preserve it during source updates.
# One NAME=value per line; each name must have only one active entry.
# Comments must occupy their own lines. Inline comments are unsupported.
# Matching outer quotes are removed. No shell execution, $VARIABLE expansion
# or backslash escaping occurs; password values remain literal.
# Only the PM seed and backup directory fields expand leading ~/.
# Process environment values override this file. Restart Uvicorn after changes.

# ==== Public Nginx/browser address ====

# Address clients use to open the website, including http/https and any port.
# Must match Nginx Host and scheme. This is not the database or Uvicorn address.
PAK_PUBLIC_URL=http://192.168.12.92

# Explicitly allow your current HTTP-only browser/API connection. Default: false.
# When Nginx uses HTTPS, change PUBLIC_URL to https://... and set this false.
PAK_ALLOW_INSECURE_HTTP=true

# ==== PostgreSQL connection ====

# Database address as reached FROM THE MACHINE RUNNING UVICORN.
# Use 127.0.0.1 on the same server as the Docker-published PostgreSQL port.
# Use 192.168.12.92 for a backend running on another computer.
# Use a numeric internal IP; the literal hostname localhost is not accepted.
PAK_DB_HOST=127.0.0.1

# Published PostgreSQL host port. Your FanipakDB container publishes port 5432.
# This is not the Uvicorn port (5187).
PAK_DB_PORT=5432

# Exact existing PostgreSQL database name; change if yours differs.
# This setting does not create the database or install the required PAK schema 10.
PAK_DB_NAME=pak_maintenance

# Limited PostgreSQL application login, not a user account inside the website.
# Use the pak database role provisioned for the backend, not a superuser/owner.
PAK_DB_USER=pak

# Replace this placeholder privately with the pak database role password.
# Punctuation such as !, :, #, $, = and backslash stays literal.
# Do not put the real password in comments, source control or shared logs.
PAK_DB_PASSWORD="CHANGE_ME_PASSWORD"

# Supported values: disable or verify-full.
# disable needs the matching loopback/LAN allowance below.
# verify-full needs a local CA and a server certificate matching DB_HOST.
PAK_DB_SSLMODE=disable

# Set true for DB_HOST=127.0.0.1 or ::1 with SSLMODE=disable.
# Set false when using a remote address. Default when omitted: false.
PAK_DB_ALLOW_LOOPBACK_PLAINTEXT=true

# Set true only for an explicit unencrypted private-LAN test with SSLMODE=disable.
# For example: remote DB_HOST=192.168.12.92. Public IPs remain rejected.
# Keep false for the current loopback setup or certificate-verified TLS.
PAK_DB_ALLOW_LAN_PLAINTEXT=false

# Absolute path to the PostgreSQL CA file when SSLMODE=verify-full.
# Example: /home/pak/Desktop/PAK-data/certificates/database-ca.crt
# Must be EMPTY when SSLMODE=disable. This field does not expand ~/.
PAK_DB_SSLROOTCERT=

# Database connection timeout in seconds. Integer 1–30. Default: 5.
PAK_DB_CONNECT_TIMEOUT=5

# ==== Runtime files owned by the Uvicorn user ====

# Folder containing BOTH pm-import.json and the complete pm-originals/ folder.
# Point at seed itself, not its parent or pm-originals alone.
# ~/ expands to the home of the account running Uvicorn, for example /home/pak.
# Creating an empty folder is insufficient; copy the actual PM files into it.
# Keep PM documents outside the public Nginx UI directory.
PAK_PM_SEED_DIR=~/Desktop/PAK-data/seed

# Local backup destination. The account running Uvicorn needs write access.
# A directory under that account’s Desktop does not require sudo.
# This field also expands leading ~/.
PAK_BACKUP_DIR=~/Desktop/PAK-data/backups

# Company name in application configuration. Length: 1–200 characters.
PAK_COMPANY_NAME="شرکت لبنیات پاک"

# ==== Application mode and PM issuance ====

# Keep false for your manual server setup.
# HTTP and database transport exceptions have their own settings above.
PAK_DEVELOPMENT=false

# true starts automatic PM issuance from already-approved active database plans.
# Keep false until the approved final start decision.
# This neither resets records nor changes the database plan activation state.
PAK_SCHEDULING_ENABLED=false

# ==== Native PostgreSQL backups ====

# true starts the automatic backup worker. Default: false.
# Enable only after BOTH native executable paths below are configured.
# false does not disable manual backup if both tools are configured.
PAK_AUTOMATIC_BACKUP_ENABLED=false

# Hours between automatic snapshots. Integer 1–720. Default: 24.
PAK_BACKUP_INTERVAL_HOURS=24

# Registered automatic snapshots to retain. Integer 1–365. Default: 14.
# This does not prune unrelated or manual backup files.
PAK_BACKUP_RETENTION_COUNT=14

# Absolute path to real pg_dump ON THE UVICORN MACHINE.
# For PostgreSQL 18, use a compatible version 18 or newer tool.
# Example: /usr/lib/postgresql/18/bin/pg_dump
# A container-only path or /usr/bin/docker is not a pg_dump executable.
# Leave BOTH executable settings empty if native backups are not configured.
PAK_POSTGRESQL_DUMP_EXECUTABLE=

# Absolute path to real pg_restore, configured together with pg_dump.
# Its version must support the archive produced by pg_dump.
# Example: /usr/lib/postgresql/18/bin/pg_restore
PAK_POSTGRESQL_RESTORE_EXECUTABLE=

# ==== Alternative profiles: edit the active entries above ====
# Remote private-LAN database test:
#   PAK_DB_HOST=192.168.12.92
#   PAK_DB_SSLMODE=disable
#   PAK_DB_ALLOW_LOOPBACK_PLAINTEXT=false
#   PAK_DB_ALLOW_LAN_PLAINTEXT=true
#   PAK_DB_SSLROOTCERT=
#
# Certificate-verified database connection:
#   PAK_DB_SSLMODE=verify-full
#   PAK_DB_ALLOW_LOOPBACK_PLAINTEXT=false
#   PAK_DB_ALLOW_LAN_PLAINTEXT=false
#   PAK_DB_SSLROOTCERT=/absolute/path/to/postgresql-ca.crt
#
# PAK_ENV_FILE is optional and belongs in the PROCESS environment, not inside .env.
# Example shell command before starting Uvicorn:
#   export PAK_ENV_FILE="$HOME/Desktop/PAK-settings/backend.env"
# That file must exist. Never execute source .env.
